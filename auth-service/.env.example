# auth-service 环境变量示例：cp .env.example .env 后修改
# 生产必设且不可丢失——丢失将无法解密 JWKS 私钥，全部 token 失效
AUTH_MASTER_KEY=<32字节随机数的 base64，可用: openssl rand -base64 32>

AUTH_ISSUER=https://auth.example.com
AUTH_PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/auth

# 每 IP 每分钟 /authorize 请求上限
IP_RATE_MAX=10

# 多实例部署：设置后 会话/IP 限流 走 Redis 共享（不设则用内存，仅单实例）
REDIS_URL=redis://localhost:6379

# 种子脚本（仅首次）
SEED_ADMIN_PASSWORD=ChangeMe#2026
SEED_ADMIN_WEB_SECRET=<admin-web client secret>
SEED_BLOG_WEB_SECRET=<blog-web client secret>
