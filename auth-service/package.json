{
  "name": "auth-service",
  "version": "0.1.0",
  "private": true,
  "description": "auth domain - OIDC Authorization Server (authorization code + PKCE)",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsc && node dist/server.js",
